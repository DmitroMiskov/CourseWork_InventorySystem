# ==============================================================================
# КОНФІГУРАЦІЯ СЕРЕДОВИЩА СИСТЕМИ СКЛАДСЬКОГО ОБЛІКУ (INVENTORY SYSTEM)
# Скопіюйте цей файл у `.env` для перевизначення параметрів: cp .env.example .env
# ==============================================================================

# --- 1. БАЗА ДАНИХ (PostgreSQL 15 Alpine) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=inventory_db
POSTGRES_PORT=5432

# --- 2. БЕЗПЕКА ТА JWT ТОКЕНИ ---
# Секретний ключ для підпису JWT токенів (мінімум 32 символи)
JWT_KEY=TUT_DUZHE_SECRETNY_KEY_DLYA_KURSOVOI_ROBOTY_12345

# --- 3. ПОЧАТКОВИЙ АДМІНІСТРАТОР (SUPERUSER) ---
SUPERUSER_USERNAME=admin
SUPERUSER_PASSWORD=Admin123!
SUPERUSER_ROLE=Admin

# --- 4. МЕРЕЖЕВІ ПОРТИ СЕРВІСІВ (HOST PORTS) ---
# Порт веб-інтерфейсу (Nginx у продакшні, Vite у розробці)
CLIENT_PORT=80

# Порт бекенд API (.NET 9)
API_PORT=8080

# Порт мікросервісу ML-прогнозування (FastAPI Python)
ML_PORT=8000
